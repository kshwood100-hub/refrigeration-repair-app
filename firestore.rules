rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // allowed_users: 본인 이메일 doc만 읽기 허용. 쓰기는 서버(Paddle webhook 등)에서만.
    match /allowed_users/{email} {
      allow read: if request.auth != null
                  && request.auth.token.email_verified == true
                  && request.auth.token.email == email;
      allow write: if false;
    }

    // usage: AI 호출 카운터. 클라이언트는 접근 불가, 서버(Cloud Functions admin SDK)만 read/write.
    match /usage/{email}/{document=**} {
      allow read, write: if false;
    }

    // 그 외 모든 컬렉션 차단 (필요 시 명시적으로 추가)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
