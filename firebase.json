{
  "emulators": {
    "dataconnect": {
      "dataDir": "dataconnect/.dataconnect/pgliteData"
    }
  },
  "dataconnect": {
    "source": "dataconnect"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      }
    ],
    "rewrites": [
      {
        "source": "/api/scan-card",
        "function": "scanCard"
      },
      {
        "source": "/api/classify-knowhow",
        "function": "classifyKnowhow"
      },
      {
        "source": "/api/classify",
        "function": "classify"
      },
      {
        "source": "/api/extract-knowhow",
        "function": "extractKnowhow"
      },
      {
        "source": "/api/whisper",
        "function": "whisper"
      },
      {
        "source": "/api/scan-equipment",
        "function": "scanEquipment"
      },
      {
        "source": "/api/scan-invoice",
        "function": "scanInvoice"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
